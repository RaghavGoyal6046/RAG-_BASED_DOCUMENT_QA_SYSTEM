# Application Configuration
APP_NAME="RAG-Based Document Q&A System"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration: "openai", "gemini", or "offline" (mock for local dev/testing without API keys)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Embeddings Provider: "openai", "gemini", or "local"
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# API Keys (Set the one corresponding to your chosen provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Pipeline Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.3

# Storage Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
